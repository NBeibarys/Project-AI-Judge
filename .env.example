# Which program the CLI grades: fellowship_v2, r2b, or alchemist. Required.
PROGRAM=

# --- Model access: pick Vertex AI (below) OR a Gemini API key ---
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Service account JSON, read by Google's Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=
# For the API-key path instead: set GOOGLE_GENAI_USE_VERTEXAI=FALSE and this.
# GOOGLE_API_KEY=

# Service account JSON for Sheets + Drive. Required either way.
GOOGLE_SERVICE_ACCOUNT_PATH=

# --- Sheet geometry per program: SHEET_ID required for the one you run ---
FELLOWSHIP_V2_SHEET_ID=
FELLOWSHIP_V2_SHEET_RANGE=Grading Final
FELLOWSHIP_V2_HEADER_ROW=2
FELLOWSHIP_V2_TOP_LABEL_ROW=1

ALCHEMIST_SHEET_ID=
ALCHEMIST_SHEET_RANGE=Sheet1
ALCHEMIST_HEADER_ROW=1
ALCHEMIST_TOP_LABEL_ROW=0

# R2B runs a separate sheet per round; the dashboard sets its ID per session.
R2B_SHEET_ID=
R2B_SHEET_RANGE=Sheet1
R2B_HEADER_ROW=2
R2B_TOP_LABEL_ROW=1

# --- Models. Required, no defaults; HEAD_MODEL falls back to GRADER_MODEL ---
ANALYZER_MODEL=gemini-3.5-flash
GRADER_MODEL=gemini-3.5-flash
HEAD_MODEL=

# --- Run tuning: N_SAMPLES = head re-runs averaged per applicant;
# MAX_CONCURRENCY = 3 is the value proven safe on trial-tier quota ---
N_SAMPLES=3
MAX_CONCURRENCY=3
