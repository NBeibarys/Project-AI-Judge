# Gemini authenticates model calls; the service account authenticates Sheets.
GOOGLE_API_KEY=
GOOGLE_SERVICE_ACCOUNT_PATH=
FELLOWSHIP_SHEET_ID=

# Sheet geometry remains environment-owned because cohorts may use different layouts.
FELLOWSHIP_SHEET_RANGE=Grading Final
FELLOWSHIP_HEADER_ROW=2
FELLOWSHIP_TOP_LABEL_ROW=1
AI_SCORE_COLUMN=
AI_REASONING_COLUMN=

# Both roles default to the same stable multimodal model unless explicitly overridden.
ANALYZER_MODEL=gemini-3.5-flash
GRADER_MODEL=gemini-3.5-flash

# Bound concurrency protects model quotas; checkpointing enables safe restart.
MAX_CONCURRENCY=4
CHECKPOINT_PATH=checkpoint.json
