# Program selection: "fellowship_v2", "r2b", or "alchemist" — REQUIRED, no
# default. main.py raises immediately if this is unset, on purpose: a
# silent default here previously caused real confusion (grading/discussing
# the wrong program without realizing PROGRAM was stale or unset).
# Determines which rubric/prompts/sheet the CLI run (src/main.py) targets —
# one process run grades exactly one program's sheet. The Streamlit
# dashboard (app.py) ignores this var entirely: it has its own sidebar
# program picker and can override the sheet ID per session.
PROGRAM=

# --- Gemini model access: Vertex AI OR Developer API (pick one) ---
#
# Option A — Vertex AI. This is what production actually runs on here
# (e.g. a GCP trial-credit account). Set GOOGLE_GENAI_USE_VERTEXAI=TRUE and
# fill these in:
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS is not read directly by this codebase —
# it's the standard var Google's Application Default Credentials (ADC)
# mechanism picks up automatically to authenticate Vertex AI calls. Point
# it at the same service account JSON as GOOGLE_SERVICE_ACCOUNT_PATH below.
GOOGLE_APPLICATION_CREDENTIALS=
#
# Option B — Gemini Developer API (API key, no GCP billing account
# required). Set GOOGLE_GENAI_USE_VERTEXAI=FALSE (or leave it unset) and
# fill this in instead of the Vertex AI block above:
# GOOGLE_API_KEY=

# Service account JSON used for Google Sheets + Drive API regardless of
# which model-access option above is active (Sheets/Drive are never billed
# through Vertex AI or the Developer API).
GOOGLE_SERVICE_ACCOUNT_PATH=

# --- Sheet geometry, per program ---
# Fellowship V2 and Alchemist currently bind to one fixed sheet ID each via
# the env vars below. R2B deliberately does NOT: it runs multiple
# competition rounds, each its own sheet, so its sheet ID is entered
# per-session in the Streamlit dashboard's sidebar instead (R2B_SHEET_ID
# below is optional — only the CLI path needs it, and only if you're not
# using the dashboard). The plan is to move Fellowship V2/Alchemist to this
# same flexible per-session pattern so the app isn't permanently bound to
# fixed sheet IDs baked into .env.

# Fellowship V2
FELLOWSHIP_V2_SHEET_ID=
FELLOWSHIP_V2_SHEET_RANGE=Grading Final
FELLOWSHIP_V2_HEADER_ROW=2
FELLOWSHIP_V2_TOP_LABEL_ROW=1
# Row 1 = reviewer names (AI, AI_Reasoning, Total).
# Row 2 = actual column headers (question text) — header_row=2 so column
# names come from row 2; top_label_row=1 so output column lookup finds
# AI/AI_Reasoning on row 1.
# Row 3+ = applicant data.

# Alchemist
ALCHEMIST_SHEET_ID=
ALCHEMIST_SHEET_RANGE=CRM_Form Responses 1+ updated links
ALCHEMIST_HEADER_ROW=1
ALCHEMIST_TOP_LABEL_ROW=0

# R2B — optional for the CLI path (see note above; the dashboard always
# lets you type a sheet ID per round instead).
# R2B_SHEET_ID=
R2B_SHEET_RANGE=Form Responses 1
R2B_HEADER_ROW=2
R2B_TOP_LABEL_ROW=1

# --- Models (temp=0 for all three agent roles: analyst, grader, head) ---
# No code-level default — ANALYZER_MODEL/GRADER_MODEL must be set
# explicitly or startup fails fast (see config.py). gemini-3.5-flash is the
# more reliable tier; gemini-3.1-flash-lite is cheaper but has shown lower
# reliability in production (see config.py's model-drift incident note).
ANALYZER_MODEL=gemini-3.5-flash
GRADER_MODEL=gemini-3.5-flash
# HEAD_MODEL defaults to GRADER_MODEL when left unset.
HEAD_MODEL=

# Multi-sample averaging: number of times to re-run the Head scorer per
# applicant and average. The analyst->grader verify loop runs ONCE; only
# the Head is re-run. Reduces run-to-run variance (arXiv:2606.26185 — temp=0
# is not sufficient for determinism). Default 3.
N_SAMPLES=3

# Bound concurrency protects model quotas. CAUTION: 8 caused sustained 429
# rate-limit errors in a real 100-row production run (69/100 failed) —
# root-caused to a single huge multimodal payload exhausting the trial-tier
# token quota even at zero concurrency contention, so raising this alone
# will not fix 429s on a similar trial-tier account. 3 is the value proven
# safe in production; raise cautiously and only after confirming your
# quota tier can sustain it.
MAX_CONCURRENCY=3

# Checkpoint file: tracks which rows are already graded so re-runs skip
# them. This override is honored ONLY for PROGRAM=alchemist (see
# config.py — a real bug once made every program silently share
# Alchemist's checkpoint file, so the override is now scoped to alchemist
# alone). Fellowship V2 and R2B always auto-generate their own checkpoint
# path as checkpoint_{program}_{sheet_id_hash}.json — setting
# CHECKPOINT_PATH for those programs is silently ignored.
CHECKPOINT_PATH=checkpoint_alchemist.json
