# Requires ffmpeg + ffprobe on PATH (not pip-installable) — video frame
# extraction and duration probing shell out to them directly.

# Only the key matching your configured *_MODEL values below is required —
# Config.from_env() checks which provider(s) the model names need.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GOOGLE_SERVICE_ACCOUNT_PATH=
FELLOWSHIP_SHEET_ID=
FELLOWSHIP_SHEET_RANGE=Form Responses 1

# Defaulting to Gemini Flash (free tier) for now — no Claude credit on this
# account yet. Free-tier Gemini content is used by Google to improve their
# products: fine for synthetic test data, switch before running real
# applicant PII. Swap to claude-sonnet-4-6 / claude-opus-4-8 once resolved.
ANALYZER_MODEL=gemini-3.5-flash
GRADER_MODEL=gemini-3.5-flash
WHISPER_MODEL=base

MAX_CONCURRENCY=4
CHECKPOINT_PATH=checkpoint.json
WORK_DIR=.fellowship_work
FRAME_SAMPLE_COUNT=6
