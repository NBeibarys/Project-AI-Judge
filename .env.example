# Program selection: "fellowship_v2" (default), "r2b", or "alchemist".
PROGRAM=fellowship_v2

# --- Gemini API access (Developer API via API key, no GCP billing) ---
# The project runs on the Gemini Developer API (API key + free/credits tier).
# This requires NO GCP billing account — no Cloud Run, no GCS, no Vertex AI.
# GOOGLE_API_KEY must be set; everything below it is for Sheets + Drive only.
GOOGLE_API_KEY=
# Service-account JSON used ONLY for Google Sheets API and Google Drive API
# (both free, no billing account). The Gemini model + Files API use the
# API key above, not this service account.
GOOGLE_SERVICE_ACCOUNT_PATH=

# --- Vertex AI (LEGACY, disabled) ---
# The Vertex AI path is kept in config.py as a backward-compat fallback only.
# It is NOT used by default. Leave GOOGLE_API_KEY set and these commented out.
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global

# --- R2B sheet geometry ---
# R2B sheet ID: REDACTED_SHEET_ID_R2B
R2B_SHEET_ID=
R2B_SHEET_RANGE=Form Responses 1
R2B_HEADER_ROW=2
R2B_TOP_LABEL_ROW=1

# --- Fellowship V2 sheet geometry ---
# Fellowship V2 sheet ID: REDACTED_SHEET_ID_FELLOWSHIP_V2
# Row 1 = column names (AI at col 20, AI_Reasoning at col 21).
# Row 2 = sub-headers (ignored — pipeline skips it).
# Row 3+ = applicant data. header_row=1, top_label_row=0 (no separate label
# row; output columns are resolved from the header row itself).
FELLOWSHIP_V2_SHEET_ID=
FELLOWSHIP_V2_SHEET_RANGE=Grading Final
FELLOWSHIP_V2_HEADER_ROW=1
FELLOWSHIP_V2_TOP_LABEL_ROW=0

# Models (all default to gemini-3.5-flash, temp=0 for grader/head).
# - ANALYZER_MODEL: analyst (evidence extraction).
# - GRADER_MODEL: grader (verify only).
# - HEAD_MODEL: Head scorer (scores approved evidence). Defaults to
#   GRADER_MODEL if not set. All grading roles run at temp=0.
ANALYZER_MODEL=gemini-3.5-flash
GRADER_MODEL=gemini-3.5-flash
HEAD_MODEL=

# Multi-sample averaging: number of times to re-run the Head scorer per
# applicant and average. The analyst->grader verify loop runs ONCE; only
# the Head is re-run. Reduces run-to-run variance (arXiv:2606.26185 — temp=0
# is not sufficient for determinism). Default 5.
N_SAMPLES=5

# Bound concurrency protects model quotas; checkpointing enables safe restart.
MAX_CONCURRENCY=8
CHECKPOINT_PATH=checkpoint.json
